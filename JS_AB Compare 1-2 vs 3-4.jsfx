desc:JS A/B Compare 1-2 vs 3-4
options:gfx_hz=30

slider1:1<1,2,1{A ch1-2,B ch3-4}>Active source
slider2:5<0,50,1>Switch fade (ms)

in_pin:A left (ch1)
in_pin:A right (ch2)
in_pin:B left (ch3)
in_pin:B right (ch4)
out_pin:Out left
out_pin:Out right
out_pin:
out_pin:

@init
gfx_w = 360;
gfx_h = 140;

active_sel = slider1|0;
target_mix = active_sel == 2 ? 1 : 0;
mix = target_mix;

last_mouse_cap = 0;
button_gap = 16;
button_w = 140;
button_h = 54;
button_y = 58;
button1_x = 24;
button2_x = button1_x + button_w + button_gap;

function clamp01(x)
(
  x < 0 ? 0 : x > 1 ? 1 : x;
);

function update_fade_step()
(
  fade_samples = max(1, srate * max(0, slider2) * 0.001);
  fade_step = 1 / fade_samples;
);

function set_selection(new_sel)
(
  new_sel = new_sel|0;
  new_sel < 1 ? new_sel = 1;
  new_sel > 2 ? new_sel = 2;

  active_sel = new_sel;
  slider1 = new_sel;
  target_mix = new_sel == 2 ? 1 : 0;
);

function point_in_rect(px, py, rx, ry, rw, rh)
(
  px >= rx && px < rx + rw && py >= ry && py < ry + rh;
);

function draw_button(x, y, w, h, is_active, line1, line2)
local(text_y1, text_y2)
(
  is_active ? (
    gfx_set(0.12, 0.72, 0.40, 1);
  ) : (
    gfx_set(0.20, 0.22, 0.24, 1);
  );
  gfx_roundrect(x, y, w, h, 8, 1);

  is_active ? (
    gfx_set(0.90, 1.00, 0.94, 1);
  ) : (
    gfx_set(0.78, 0.82, 0.84, 1);
  );
  gfx_roundrect(x + 1, y + 1, w - 2, h - 2, 8, 0);

  gfx_setfont(1, "Arial", 22, 700);
  gfx_measurestr(line1, txt_w, txt_h);
  text_y1 = y + 8;
  gfx_x = x + (w - txt_w) * 0.5;
  gfx_y = text_y1;
  gfx_drawstr(line1);

  gfx_setfont(1, "Arial", 15, 400);
  gfx_measurestr(line2, txt_w, txt_h);
  text_y2 = y + 31;
  gfx_x = x + (w - txt_w) * 0.5;
  gfx_y = text_y2;
  gfx_drawstr(line2);
);

update_fade_step();

@slider
set_selection(slider1);
update_fade_step();

@sample
mix < target_mix ? (
  mix += fade_step;
  mix > target_mix ? mix = target_mix;
) : mix > target_mix ? (
  mix -= fade_step;
  mix < target_mix ? mix = target_mix;
);

a_mix = 1 - mix;
b_mix = mix;

out_l = spl0 * a_mix + spl2 * b_mix;
out_r = spl1 * a_mix + spl3 * b_mix;

spl0 = out_l;
spl1 = out_r;
spl2 = 0;
spl3 = 0;

@gfx
gfx_clear = 0x16181a;

mouse_clicked = (mouse_cap & 1) && !(last_mouse_cap & 1);

mouse_clicked ? (
  point_in_rect(mouse_x, mouse_y, button1_x, button_y, button_w, button_h) ? set_selection(1);
  point_in_rect(mouse_x, mouse_y, button2_x, button_y, button_w, button_h) ? set_selection(2);
);
last_mouse_cap = mouse_cap;

gfx_set(0.92, 0.95, 0.97, 1);
gfx_setfont(1, "Arial", 20, 700);
gfx_x = 24;
gfx_y = 18;
gfx_drawstr("A/B Compare");

gfx_set(0.62, 0.68, 0.72, 1);
gfx_setfont(1, "Arial", 14, 400);
gfx_x = 24;
gfx_y = 38;
gfx_drawstr("A = ch1-2    B = ch3-4");

draw_button(button1_x, button_y, button_w, button_h, active_sel == 1, "A", "ch1-2");
draw_button(button2_x, button_y, button_w, button_h, active_sel == 2, "B", "ch3-4");

gfx_setfont(1, "Arial", 13, 400);
gfx_set(active_sel == 1 ? 0.12 : 0.62, active_sel == 1 ? 0.72 : 0.68, active_sel == 1 ? 0.40 : 0.72, 1);
gfx_x = 24;
gfx_y = 122;
gfx_drawstr(active_sel == 1 ? "Aktiv: A / ch1-2" : "Aktiv: B / ch3-4");
